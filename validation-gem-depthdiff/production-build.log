                float rdGemFresnel = 1.0 - rdGemNdotV;
                float rdGemFresnelBand = smoothstep(
                    clamp(uGemFresnelThreshold - uGemFresnelFeather, 0.0, 1.0),
                    clamp(uGemFresnelThreshold + uGemFresnelFeather, 0.001, 1.0),
