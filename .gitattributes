# Resource manifests and evidence hash the committed JSON bytes. Do not let
# platform autocrlf conversion silently change sizes or signed source records.
*.json -text
public/stages/official/battle-603-00-00-001/lightmap-bindings.json text eol=lf
# Unified-diff context lines intentionally begin with the diff marker followed
# by source indentation and blank context carries one marker space.
patches/*.patch whitespace=-blank-at-eol,-space-before-tab
# This generated shard is byte-hashed in its evidence/rollback records. Preserve
# the emitted CRLF bytes while treating CR as part of the line ending.
public/stages/catalog/battle-601-00-01-001.json whitespace=cr-at-eol

# Existing committed CRLF test fixtures keep their native line endings.
uiLocalization.test.mjs whitespace=cr-at-eol
enemyAnimationInteraction.test.mjs whitespace=cr-at-eol
