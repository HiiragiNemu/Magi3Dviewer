# Static delivery for the single Cloudflare production site.
# No credentials, cookies or private API routes are exposed by these headers.
# Vite emits content-hashed names in this directory. Only immutable build
# assets get a long browser cache; HTML and mutable catalogs stay revalidated.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/stages/official/*
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS
  X-Content-Type-Options: nosniff

/site-version.json
  Access-Control-Allow-Origin: *
  Cache-Control: no-store

/catalogs/runtime-product-delivery.v1.json
  Cache-Control: no-cache

# The HTML document must not strand an old build under a bookmarked query URL.
# Hashed JavaScript/CSS and large model assets keep their own caching policy.
/
  Cache-Control: no-store, max-age=0
  Cloudflare-CDN-Cache-Control: no-store
  X-Magius-Revision: __MAGIUS_BUILD_REVISION__

/index.html
  Cache-Control: no-store, max-age=0
  Cloudflare-CDN-Cache-Control: no-store
  X-Magius-Revision: __MAGIUS_BUILD_REVISION__
